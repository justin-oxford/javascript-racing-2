{
  "name": "javascript-racing",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Top-down browser racing game. Rebuild of the 2019 v0.16 game.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.sim.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "draft-mask": "node tools/draft-mask.ts public/assets/BGs/indiana.jpg tracks/indiana/mask-draft.png tracks/indiana/draft-hints.json",
    "validate-track": "tsx tools/validate-track.ts",
    "suggest-timing-lines": "tsx tools/suggest-timing-lines.ts",
    "drive-laps": "tsx tools/drive-laps.ts",
    "suggest-racing-line": "tsx tools/suggest-racing-line.ts",
    "ai-run": "tsx tools/ai-run.ts",
    "contact-probe": "tsx tools/contact-probe.ts",
    "handling-diag": "tsx tools/handling-diag.ts",
    "optimize-racing-line": "tsx tools/optimize-racing-line.ts",
    "tow-probe": "tsx tools/tow-probe.ts",
    "start-probe": "tsx tools/start-probe.ts",
    "quali-probe": "tsx tools/quali-probe.ts",
    "pit-probe": "tsx tools/pit-probe.ts",
    "wear-probe": "tsx tools/wear-probe.ts",
    "equal-probe": "tsx tools/equal-probe.ts",
    "damage-probe": "tsx tools/damage-probe.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "lil-gui": "^0.21.0",
    "planck": "^1.5.1"
  }
}
